# Đổi tên file thành .env rồi điền thông tin

# Telegram (tạo bot qua @BotFather, lấy chat id qua @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Danh sách coin & khung thời gian quét
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,DOGEUSDT,ADAUSDT,LINKUSDT
TIMEFRAMES=15m,1h

# Tham số SMC
SWING_LENGTH=10
CANDLE_LIMIT=500
FRESH_BARS=2
MAX_GAP_BARS=50

# Scanner
SCAN_INTERVAL=60
CONCURRENCY=8
PORT=8000
KLINE_POLL_INTERVAL=1

# Accumulation screener (tìm coin giá thấp đang siết chặt biến động, có thể sắp bứt phá)
SCREENER_MAX_PRICE=0.1
SCREENER_MIN_QUOTE_VOLUME=1000000
SCREENER_INTERVAL=3600
SCREENER_TOP_N=25
SCREENER_INTRADAY_TIMEFRAME=1h
SCREENER_INTRADAY_LOOKBACK=48
SCREENER_DAILY_WEIGHT=0.55
